# Database (Railway Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/db

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the web app lives (CORS + redirects back after Gmail connect)
CLIENT_URL=http://localhost:5173

# OpenAI (email extraction, classification, cover letters)
OPENAI_API_KEY=sk-...

# Signs browser-extension tokens and the Gmail connect state parameter.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXT_JWT_SECRET=

# ── Gmail sync (optional; the Settings card says "not configured" without these) ──
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Enable the Gmail API, add the redirect URI below, and add your Gmail address
# as a test user on the OAuth consent screen while the app is in Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the server's public URL exactly
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback
# Encrypts stored refresh tokens: 32 bytes as hex (64 chars) or base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
